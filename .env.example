# WerkPlus – Produktionskonfiguration
# Kopiere diese Datei nach ".env" und trage deine Werte ein. Die .env kommt NICHT
# ins Git-Repo (steht in .gitignore).

# --- Pflicht ---------------------------------------------------------------
# Sicherer Sitzungsschlüssel (min. 16 Zeichen). Erzeugen z. B. mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
WERKPLUS_SECRET_KEY=BITTE-HIER-EINEN-LANGEN-ZUFALLSWERT-EINTRAGEN

# Erstes Admin-Passwort (wird beim allerersten Start gesetzt; danach in der App änderbar)
WERKPLUS_ADMIN_PASSWORT=BITTE-AENDERN

# --- Sicherheit ------------------------------------------------------------
# Session-Cookie nur über HTTPS senden. In Produktion standardmäßig AN.
# WICHTIG: Wird WerkPlus direkt über HTTP aufgerufen (z. B. http://<NAS-IP>:9999
# ohne HTTPS-Reverse-Proxy), sendet der Browser das Cookie nicht und der Login
# scheitert. Dann hier auf 0 setzen — besser ist aber HTTPS im Reverse-Proxy.
#WERKPLUS_COOKIE_SECURE=0

# --- Betrieb ---------------------------------------------------------------
# Log-Level der Anwendung: DEBUG, INFO (Standard), WARNING, ERROR, CRITICAL.
# Die Ausgabe geht nach stdout, also sichtbar über "docker logs werkplus"
# bzw. im Synology Container Manager. Protokolliert werden u. a. Logins,
# Fehlversuche und Sperren — nie Passwörter oder Tokens.
#WERKPLUS_LOG_LEVEL=INFO

# --- Firmenstammdaten (erscheinen auf Beleg-PDFs; später auch in der App pflegbar) ---
WERKPLUS_FIRMA_NAME=Meine Haustechnik GmbH
WERKPLUS_FIRMA_STRASSE=Musterstraße 1
WERKPLUS_FIRMA_PLZ=4020
WERKPLUS_FIRMA_ORT=Linz
WERKPLUS_FIRMA_LAND=Österreich
WERKPLUS_FIRMA_UID=ATU00000000
WERKPLUS_FIRMA_TELEFON=+43 000 000000
WERKPLUS_FIRMA_EMAIL=office@example.at
WERKPLUS_FIRMA_IBAN=AT00 0000 0000 0000 0000

# --- Bug-Melder → GitHub Issues (optional) ---------------------------------
# Fein granulierter Personal Access Token mit Schreibrecht auf Issues deines
# privaten Repos, und das Repo im Format "besitzer/repo". Leer lassen = Bug-
# Meldungen werden nur lokal in WerkPlus gespeichert (kein GitHub-Issue).
WERKPLUS_GITHUB_TOKEN=
WERKPLUS_GITHUB_REPO=
